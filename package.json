{
  "name": "babworld",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "preinstall": "npx only-allow pnpm",
    "validate:content": "tsx scripts/validate-content.ts",
    "generate:rss": "tsx scripts/generate-rss.ts",
    "test": "tsx src/lib/__tests__/sphereMath.test.ts",
    "test:visual": "playwright test",
    "pre-commit": "tsx scripts/validate-content.ts && node scripts/build-town-manifest.mjs --check && tsx src/lib/__tests__/sphereMath.test.ts && tsx src/lib/__tests__/minimap.test.ts && tsc --noEmit",
    "build": "tsx scripts/validate-content.ts && tsx scripts/generate-rss.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "assets:budget": "node scripts/check-asset-budget.mjs",
    "verify:dod": "node scripts/verify-dod.mjs",
    "capture:poses": "node scripts/capture-poses.mjs",
    "assets:vrm": "node scripts/optimize-vrm.mjs",
    "assets:town": "node scripts/build-town-manifest.mjs"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.4",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/three": "^0.184.1",
    "framer-motion": "^12.40.0",
    "gray-matter": "^4.0.3",
    "next": "16.2.9",
    "next-mdx-remote": "^6.0.0",
    "postprocessing": "^6.39.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.184.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0",
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix"
    ],
    "src/content/**/*.mdx": [
      "tsx scripts/validate-content.ts"
    ]
  }
}
